      <div class="flex gap-2 mt-4" style="justify-content: flex-end;">
        <button class="btn btn-secondary" onclick="closeBulkUpdateModal()">Cancel</button>
        <button class="btn btn-primary" onclick="submitBulkUpdate()">Update</button>
      </div>
