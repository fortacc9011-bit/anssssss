  <div id="toast"></div>

  <script>
    const API = window.location.origin + '/api';
    let token = (() => { try { return localStorage.getItem('admin_token'); } catch (e) { return null; } })();
    let currentProducts = [];
    let currentCategories = [];
    let editingProductId = null;
    let selectedProducts = new Set();
    let editingCategoryId = null;
    let variantCount = 0;
    let productExistingImages = [];
    let productNewFiles = [];

    // ── Security Helpers ─────────────────────────────────────────────────────────

    function escapeHTML(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Keep escapeHtml as alias to avoid breaking existing usages
    const escapeHtml = escapeHTML;

    function renderProductImagesPreview() {
      const preview = document.getElementById('p-images-preview');
      if (!preview) return;
      preview.innerHTML = '';

      // Render existing images
      productExistingImages.forEach((imgName, index) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'image-preview-wrapper';

        const img = document.createElement('img');
        img.src = `${window.location.origin}/uploads/${escapeHTML(imgName)}`;
        img.onerror = () => { wrapper.style.display = 'none'; };

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.innerHTML = '✕';
        delBtn.className = 'image-delete-btn';
        delBtn.onclick = () => {
          productExistingImages.splice(index, 1);
          renderProductImagesPreview();
        };

        wrapper.appendChild(img);
        wrapper.appendChild(delBtn);
        preview.appendChild(wrapper);
      });

      // Render new images
      productNewFiles.forEach((file, index) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'image-preview-wrapper';

        const img = document.createElement('img');
        img.src = URL.createObjectURL(file);
        img.style.border = '2px dashed var(--primary)';

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.innerHTML = '✕';
        delBtn.className = 'image-delete-btn';
        delBtn.onclick = () => {
          productNewFiles.splice(index, 1);
          renderProductImagesPreview();
        };

        wrapper.appendChild(img);
        wrapper.appendChild(delBtn);
        preview.appendChild(wrapper);
      });
    }

    function sanitizeHTML(html) {
      if (!html) return '';
      try {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');

        // Remove scripts and elements that could load external payloads
        doc.querySelectorAll('script, iframe, embed, object, link, style').forEach(el => el.remove());

        // Clean attributes
        doc.querySelectorAll('*').forEach(el => {
          const attrs = el.attributes;
          for (let i = attrs.length - 1; i >= 0; i--) {
            const name = attrs[i].name.toLowerCase();
            const value = attrs[i].value.toLowerCase().trim();
            if (name.startsWith('on') || value.startsWith('javascript:') || value.startsWith('data:') || value.startsWith('vbscript:')) {
              el.removeAttribute(attrs[i].name);
            }
          }
        });
        return doc.body.innerHTML;
      } catch (e) {
        return html
          .replace(/<script[^>]*>[\s\S]*?<\/script>/gi, '')
          .replace(/on\w+\s*=\s*(['"].*?['"]|[^ >\s]+)/gi, '')
          .replace(/(href|src)\s*=\s*(['"]\s*(javascript|data|vbscript):.*?['"]|[^ >\s]+)/gi, '');
      }
    }

    // ── Auth ─────────────────────────────────────────────────────────────────────

    async function doLogin() {
      const username = (document.getElementById('login-username').value || '').trim();
      const password = (document.getElementById('login-password').value || '').trim();
      const err = document.getElementById('login-error');
      const btn = document.getElementById('login-btn');
      
      err.style.display = 'none';

      if (!username || !password) {
        err.textContent = 'Please enter both username and password.';
        err.style.display = 'block';
        return;
      }

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = 'Signing In...';
      }

      try {
        const res = await fetch(`${API}/admin/login`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ username, password })
        });
        const data = await res.json();
        if (data.success && data.token) {
          token = data.token;
          try { localStorage.setItem('admin_token', token); } catch(e) {}
          showApp();
        } else {
          err.textContent = data.message || 'Invalid username or password';
          err.style.display = 'block';
        }
      } catch (e) {
        console.error('Login error:', e);
        err.textContent = 'Cannot connect to server. Check your connection or backend status.';
        err.style.display = 'block';
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = 'Sign In';
        }
      }
    }

    function logout() {
      token = null;
      try { localStorage.removeItem('admin_token'); } catch(e) {}
      location.reload();
    }

    async function api(method, path, body) {
      try {
        const headers = { 'Content-Type': 'application/json' };
        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }
        const res = await fetch(`${API}${path}`, {
          method,
          headers,
          credentials: 'include',
          body: body ? JSON.stringify(body) : undefined
        });
        if (res.status === 401) { logout(); return { success: false, message: 'Unauthorized' }; }
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          return { success: false, message: errData.message || `Server error: ${res.status}` };
        }
        return await res.json();
      } catch (e) {
        console.error('API Error:', e);
        return { success: false, message: 'Network error: cannot connect to backend server' };
      }
    }

    async function uploadFile(file) {
      try {
        const form = new FormData();
        form.append('file', file);
        const headers = {};
        if (token) {
          headers['Authorization'] = `Bearer ${token}`;
        }
        const res = await fetch(`${API}/upload`, {
          method: 'POST',
          headers,
          credentials: 'include',
          body: form
        });
        if (res.status === 401) { logout(); return { success: false, message: 'Unauthorized' }; }
        if (!res.ok) {
          return { success: false, message: `Upload failed: ${res.status}` };
        }
        return await res.json();
      } catch (e) {
        console.error('Upload Error:', e);
        return { success: false, message: 'Network error during upload' };
      }
    }

    // ── Currency Switcher & Formatter ───────────────────────────────────────────
    let currentCurrency = localStorage.getItem('selectedCurrency') || '';
    let defaultDisplayCurrency = 'USD';
    let usdToEgpRate = 50.00;
    let usdToEurRate = 0.92;

    function loadCurrencySettingsFromStore(settings) {
      if (settings) {
        if (settings.currency) {
          defaultDisplayCurrency = settings.currency;
          if (!localStorage.getItem('selectedCurrency')) {
            currentCurrency = settings.currency;
          }
        }
        if (settings.usd_to_egp_rate) usdToEgpRate = parseFloat(settings.usd_to_egp_rate) || 50.00;
        if (settings.usd_to_eur_rate) usdToEurRate = parseFloat(settings.usd_to_eur_rate) || 0.92;
      }
    }

    function formatPrice(amount, sourceCurrency = null) {
      const src = sourceCurrency || 'USD';
      // 1. Convert from src to USD (Hub)
      let amountInUsd = amount;
      if (src === 'EGP') {
        amountInUsd = amount / usdToEgpRate;
      } else if (src === 'EUR') {
        amountInUsd = amount / usdToEurRate;
      }

      // 2. Convert from USD to target
      const targetCurrency = currentCurrency || defaultDisplayCurrency || 'USD';
      let converted = amountInUsd;
      if (targetCurrency === 'EGP') converted = amountInUsd * usdToEgpRate;
      else if (targetCurrency === 'EUR') converted = amountInUsd * usdToEurRate;

      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: targetCurrency
      }).format(converted);
    }

    function renderTopbarCurrencySelector() {
      const container = document.getElementById('topbar-currency-container');
      if (!container) return;

      const activeCurrency = currentCurrency || defaultDisplayCurrency;
      container.innerHTML = `
        <select id="currency-selector" onchange="changeAdminCurrency(this.value)" style="padding: 6px 12px; font-size: 13px; font-weight: 600; border-radius: 8px; background: var(--surface2); border: 1px solid var(--border); color: var(--text); width: auto; cursor: pointer; outline: none;">
          <option value="USD" ${activeCurrency === 'USD' ? 'selected' : ''}>USD ($)</option>
          <option value="EUR" ${activeCurrency === 'EUR' ? 'selected' : ''}>EUR (€)</option>
          <option value="EGP" ${activeCurrency === 'EGP' ? 'selected' : ''}>EGP (ج.م)</option>
        </select>
      `;
    }

    function changeAdminCurrency(currency) {
      currentCurrency = currency;
      localStorage.setItem('selectedCurrency', currency);
      const activeNavItem = document.querySelector('.nav-item.active');
      if (activeNavItem) {
        const section = activeNavItem.dataset.section;
        showSection(section);
      }
    }

    function showSpinner() {
      document.getElementById('content').innerHTML = `
    <div class="loading-overlay">
      <div class="spinner"></div>
      <p style="color: var(--muted); font-size: 14px; font-weight: 500;">Loading data, please wait...</p>
    </div>`;
    }

    // ── App Init ─────────────────────────────────────────────────────────────────

    async function showApp() {
      document.getElementById('login-screen').style.display = 'none';
      document.getElementById('app').style.display = 'flex';

      // Load settings to fetch currency rates
      const res = await api('GET', '/admin/settings');
      if (res && res.success) {
        loadCurrencySettingsFromStore(res.data);
      }
      renderTopbarCurrencySelector();

      await loadCategories();
      showSection('dashboard');
    }

    function showSection(name) {
      document.querySelectorAll('.nav-item').forEach(el => {
        el.classList.toggle('active', el.dataset.section === name);
      });
      document.getElementById('page-title').textContent = {
        dashboard: 'Dashboard', products: 'Products', categories: 'Categories',
        orders: 'Orders', reviews: 'Reviews', settings: 'Settings'
      }[name] || name;

      const actions = document.getElementById('topbar-actions');
      actions.innerHTML = '';

      if (name === 'products') {
        actions.innerHTML = `<button class="btn btn-primary" onclick="openProductModal()">+ Add Product</button>`;
        loadProducts();
      } else if (name === 'categories') {
        actions.innerHTML = `<button class="btn btn-primary" onclick="openCategoryModal()">+ Add Category</button>`;
        renderCategories();
      } else if (name === 'orders') {
        loadOrders();
      } else if (name === 'reviews') {
        actions.innerHTML = `<button class="btn btn-primary" onclick="openReviewModal()">+ Add Review</button>`;
        loadReviews();
      } else if (name === 'settings') {
        loadSettings();
      } else {
        loadDashboard();
      }
    }

    // ── Dashboard ─────────────────────────────────────────────────────────────────

    async function loadDashboard() {
      showSpinner();
      const [productsData, ordersData, reviewsData] = await Promise.all([
        api('GET', '/admin/products'),
        api('GET', '/admin/orders'),
        api('GET', '/admin/reviews')
      ]);

      if (!productsData?.success || !ordersData?.success || !reviewsData?.success) {
        document.getElementById('content').innerHTML = `
      <div class="card" style="text-align:center;padding:48px">
        <div style="color:var(--danger);font-size:48px;margin-bottom:16px">⚠️</div>
        <h3>Failed to load dashboard data</h3>
        <p style="color:var(--muted);margin:8px 0 24px">${productsData?.message || ordersData?.message || reviewsData?.message || 'Check database connection.'}</p>
        <button class="btn btn-primary" onclick="loadDashboard()">Retry</button>
      </div>`;
        return;
      }

      const products = productsData?.data || [];
      const orders = ordersData?.data || [];
      const reviews = reviewsData?.data || [];
      const revenue = orders.filter(o => o.status === 'completed').reduce((s, o) => s + o.total, 0);

      document.getElementById('content').innerHTML = `
    <div class="stats-grid">
      <div class="stat-card"><div class="stat-label">Total Products</div><div class="stat-value">${products.length}</div></div>
      <div class="stat-card"><div class="stat-label">Total Orders</div><div class="stat-value">${orders.length}</div></div>
      <div class="stat-card"><div class="stat-label">Pending Orders</div><div class="stat-value" style="color:var(--warning)">${orders.filter(o => o.status === 'pending').length}</div></div>
      <div class="stat-card"><div class="stat-label">Revenue</div><div class="stat-value" style="color:var(--success)">${formatPrice(revenue)}</div></div>
    </div>
    <div class="card">
      <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
        <h3>Recent Orders</h3>
        <button class="btn btn-secondary btn-sm" onclick="showSection('orders')" style="display:flex;align-items:center;gap:6px;">
          View All Orders &rarr;
        </button>
      </div>
      <table>
        <thead>
          <tr>
            <th>Order ID</th>
            <th>Email</th>
            <th>Total</th>
            <th>Status</th>
            <th>Date</th>
            <th style="text-align:right">Action</th>
          </tr>
        </thead>
        <tbody>${orders.slice(0, 8).map(o => `
          <tr style="cursor:pointer" onclick="showOrderDetails('${escapeHTML(o.id)}')">
            <td>
              <div style="display:flex;align-items:center;gap:6px">
                <span style="font-family:monospace;font-size:12px;font-weight:600;color:var(--primary)">#${escapeHTML(o.id.slice(0, 8))}</span>
                <button type="button" class="btn btn-secondary btn-sm" style="padding:2px 6px;font-size:10px" onclick="event.stopPropagation();navigator.clipboard.writeText('${escapeHTML(o.id)}');toast('Order ID copied!', 'success');" title="Copy full ID">📋</button>
              </div>
            </td>
            <td>${escapeHTML(o.email)}</td>
            <td><strong>${formatPrice(o.total)}</strong></td>
            <td>${statusBadge(o.status)}</td>
            <td style="color:var(--muted)">${escapeHTML(new Date(o.created_at).toLocaleDateString())}</td>
            <td style="text-align:right">
              <button class="btn btn-secondary btn-sm" onclick="event.stopPropagation();showOrderDetails('${escapeHTML(o.id)}')">
                View &rarr;
              </button>
            </td>
          </tr>`).join('') || '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:24px">No orders yet</td></tr>'}
        </tbody>
      </table>
    </div>`;
    }

    // ── Products ──────────────────────────────────────────────────────────────────

    async function loadCategories() {
      const res = await api('GET', '/admin/categories');
      if (res && res.success) {
        currentCategories = res.data || [];
      } else {
        currentCategories = [];
        toast(res?.message || 'Failed to load categories', 'error');
      }
    }

    async function loadProducts() {
      showSpinner();
      const res = await api('GET', '/admin/products');
      if (!res || !res.success) {
        document.getElementById('content').innerHTML = `
      <div class="card" style="text-align:center;padding:48px">
        <div style="color:var(--danger);font-size:48px;margin-bottom:16px">⚠️</div>
        <h3>Failed to load products</h3>
        <p style="color:var(--muted);margin:8px 0 24px">${res?.message || 'Check connection to backend server.'}</p>
        <button class="btn btn-primary" onclick="loadProducts()">Retry</button>
      </div>`;
        return;
      }
      currentProducts = res.data || [];
      const baseUrl = window.location.origin;

      document.getElementById('content').innerHTML = `
    <div class="card">
      <table>
        <thead><tr>
          <th style="width: 40px; padding-left: 16px;"><input type="checkbox" id="selectAllProducts" onchange="toggleSelectAllProducts(this.checked)"></th>
          <th>Image</th><th>Name</th><th>Category</th><th>Variants</th><th>Price</th><th>Visibility</th><th>Actions</th>
        </tr></thead>
        <tbody>${currentProducts.map(p => {
        const img = p.imageNames?.[0] ? `<img src="${baseUrl}/uploads/${escapeHTML(p.imageNames[0])}" class="product-img" onerror="this.style.display='none'">` : '<div class="product-img" style="background:var(--surface2);display:flex;align-items:center;justify-content:center;color:var(--muted)">?</div>';
        const cat = currentCategories.find(c => c.id === p.category_id);
        let bColor = p.discount_badge_color || '#ef4444';
        let tPos = p.trending_position || '';
        try {
          if (p.metadata) {
            const m = typeof p.metadata === 'string' ? JSON.parse(p.metadata) : p.metadata;
            if (m.discountBadgeColor) bColor = m.discountBadgeColor;
            if (m.trendingPosition) tPos = m.trendingPosition;
          }
        } catch(e) {}
        const discBadge = (p.discount_percent && p.discount_percent > 0)
          ? `<span class="badge" style="background:${bColor}22; color:${bColor}; border:1px solid ${bColor}60; font-size:11px; padding:2px 7px; margin-left:6px; border-radius:6px; font-weight:bold">-${p.discount_percent}%</span>`
          : '';
        let trendingBadge = '';
        if (tPos === 'center') {
          trendingBadge = `<span class="badge" style="background:rgba(59,130,246,0.15); color:#60a5fa; border:1px solid rgba(59,130,246,0.4); font-size:10px; padding:2px 6px; border-radius:6px; font-weight:bold; margin-left:4px" title="Trending: Center">⭐ منتصف</span>`;
        } else if (tPos === 'left') {
          trendingBadge = `<span class="badge" style="background:rgba(139,92,246,0.15); color:#a78bfa; border:1px solid rgba(139,92,246,0.4); font-size:10px; padding:2px 6px; border-radius:6px; font-weight:bold; margin-left:4px" title="Trending: Left">⬅️ يسار</span>`;
        } else if (tPos === 'right') {
          trendingBadge = `<span class="badge" style="background:rgba(236,72,153,0.15); color:#f472b6; border:1px solid rgba(236,72,153,0.4); font-size:10px; padding:2px 6px; border-radius:6px; font-weight:bold; margin-left:4px" title="Trending: Right">➡️ يمين</span>`;
        }
        const costs = (p.variants || []).map(v => Number(v.cost)).filter(c => !isNaN(c) && c > 0);
        const minCost = costs.length ? Math.min(...costs) : (p.variants?.[0]?.cost ? Number(p.variants[0].cost) : null);
        let priceHtml = '<span class="text-muted">—</span>';
        if (minCost !== null) {
          const currSymbol = p.currency === 'EUR' ? '€' : p.currency === 'EGP' ? 'EGP ' : '$';
          if (p.discount_percent && p.discount_percent > 0) {
            const discPrice = (minCost * (1 - p.discount_percent / 100)).toFixed(2);
            priceHtml = `<div>
              <span style="text-decoration:line-through;color:var(--muted);font-size:11px;margin-right:4px">${currSymbol}${minCost.toFixed(2)}</span>
              <span style="color:#10b981;font-weight:700;font-size:13px">${currSymbol}${discPrice}</span>
