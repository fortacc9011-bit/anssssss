    async function loadVariantStock() {
      if (!activeStockVariantId) return;

      const res = await api('GET', `/admin/variants/${activeStockVariantId}/stock`);
      if (!res?.success) {
        document.getElementById('stock-table-body').innerHTML = `
      <tr>
        <td colspan="3" style="text-align:center;padding:16px;color:var(--danger)">
          Failed to load stock keys: ${res?.message || 'Server error'}
        </td>
      </tr>`;
        return;
      }

      const stockItems = res.data || [];
      document.getElementById('stock-table-body').innerHTML = stockItems.map(item => {
        const statusText = item.is_used
          ? `<span class="badge badge-yellow" title="Purchased by ${item.order_email || 'unknown'}">Used (${item.order_email || 'N/A'})</span>`
          : `<span class="badge badge-green">Available</span>`;

        return `
      <tr>
        <td style="font-family:monospace;font-size:12px;padding:8px">${escapeHtml(item.content)}</td>
        <td style="padding:8px">${statusText}</td>
        <td style="padding:8px">
          <button class="btn btn-danger btn-sm" onclick="deleteStockEntry('${item.id}')">Delete</button>
        </td>
      </tr>`;
      }).join('') || `<tr><td colspan="3" style="text-align:center;color:var(--muted);padding:16px">No keys added yet. Add some above.</td></tr>`;
