    async function saveVariantStock() {
      if (!activeStockVariantId) return;
      const text = document.getElementById('bulk-stock-input').value;
      if (!text.trim()) return toast('Please enter some stock keys/accounts first', 'error');

      const btn = document.querySelector('button[onclick="saveVariantStock()"]');
      const oldText = btn.textContent;
      btn.textContent = 'Adding...';
      btn.disabled = true;

      const res = await api('POST', `/admin/variants/${activeStockVariantId}/stock`, { stockText: text });

      btn.textContent = oldText;
      btn.disabled = false;

      if (res?.success) {
        toast(res.message || 'Stock keys added successfully!', 'success');
        document.getElementById('bulk-stock-input').value = '';
        await loadVariantStock();
        // Update products list in background so the stock count is updated in UI
        await loadProducts();
      } else {
        toast(res?.message || 'Failed to add stock keys', 'error');
      }
    }

    async function deleteStockEntry(id) {
      if (!confirm('Delete this stock key?')) return;
      const res = await api('DELETE', `/admin/stock/${id}`);
      if (res?.success) {
        toast('Stock key deleted', 'success');
        await loadVariantStock();
        await loadProducts();
      } else {
        toast(res?.message || 'Failed to delete stock key', 'error');
      }
    }
    // ── Helpers ───────────────────────────────────────────────────────────────────

    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    function statusBadge(status) {
      const map = { pending: 'badge-yellow', processing: 'badge-blue', completed: 'badge-green', cancelled: 'badge-red' };
      return `<span class="badge ${map[status] || 'badge-yellow'}">${status}</span>`;
    }

    function toast(msg, type = 'success') {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.className = `show ${type}`;
      setTimeout(() => { el.className = ''; }, 3000);
    }

    // ── Bulk Actions ─────────────────────────────────────────────────────────────

    function toggleSelectAllProducts(checked) {
      const cbs = document.querySelectorAll('.product-select-cb');
      if (checked) {
        currentProducts.forEach(p => selectedProducts.add(p.id));
        cbs.forEach(cb => cb.checked = true);
      } else {
        selectedProducts.clear();
        cbs.forEach(cb => cb.checked = false);
      }
      updateBulkActionBar();
    }

    function toggleProductSelection(id, checked) {
      if (checked) {
        selectedProducts.add(id);
      } else {
        selectedProducts.delete(id);
      }
      const selectAll = document.getElementById('selectAllProducts');
      if (selectAll) {
        selectAll.checked = currentProducts.length > 0 && selectedProducts.size === currentProducts.length;
      }
      updateBulkActionBar();
    }

    function deselectAllProducts() {
      const selectAll = document.getElementById('selectAllProducts');
      if (selectAll) selectAll.checked = false;
      toggleSelectAllProducts(false);
    }

    function updateBulkActionBar() {
      const bar = document.getElementById('bulk-action-bar');
      const countLabel = document.getElementById('bulk-selected-count');
      if (bar && countLabel) {
        if (selectedProducts.size > 0) {
          bar.style.display = 'flex';
          countLabel.textContent = selectedProducts.size;
        } else {
          bar.style.display = 'none';
        }
      }
    }

    async function bulkDeleteProducts() {
      if (!selectedProducts.size) return;
      if (!confirm(`Delete ${selectedProducts.size} products? This cannot be undone.`)) return;

      const res = await api('DELETE', '/admin/products', { ids: Array.from(selectedProducts) });
      if (res?.success) {
        toast('Products deleted', 'success');
        selectedProducts.clear();
        loadProducts();
      } else {
        toast(res?.message || 'Failed to delete products', 'error');
      }
    }

    function openBulkUpdateModal() {
      if (!selectedProducts.size) return;
      document.getElementById('bulk-update-count').textContent = selectedProducts.size;
      document.getElementById('bulk-update-modal').classList.add('open');
    }

    function closeBulkUpdateModal() {
      document.getElementById('bulk-update-modal').classList.remove('open');
    }

    async function submitBulkUpdate() {
      const visibilityStr = document.getElementById('bulk-visibility').value;
      if (visibilityStr === "") return toast("Please select a visibility status", "error");

      const visibility = parseInt(visibilityStr);
      const res = await api('PUT', '/admin/products/bulk-visibility', { ids: Array.from(selectedProducts), visibility });
      if (res?.success) {
        toast('Products updated', 'success');
        closeBulkUpdateModal();
        selectedProducts.clear();
        loadProducts();
      } else {
        toast(res?.message || 'Failed to update products', 'error');
      }
    }

    // ── Init ──────────────────────────────────────────────────────────────────────

    if (token) {
      fetch(`${API}/admin/me`, {
        headers: { 'Authorization': `Bearer ${token}` },
        credentials: 'include'
      })
        .then(r => r.json())
        .then(d => {
          if (d.success) {
            showApp();
          } else {
            token = null;
            try { localStorage.removeItem('admin_token'); } catch (e) {}
          }
        })
        .catch(() => { });
    }
  </script>
