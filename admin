  <div class="modal-overlay" id="bulk-update-modal">
    <div class="modal" style="max-width: 400px;">
      <h3>Bulk Update Visibility</h3>
      <div class="form-group">
        <label>Select new visibility for <span id="bulk-update-count" style="font-weight:bold;">0</span>
          products:</label>
        <select id="bulk-visibility">
          <option value="">-- Choose Status --</option>
          <option value="0">Visible</option>
          <option value="1">Hidden</option>
          <option value="2">Link Only (مخفي من المتجر)</option>
        </select>
